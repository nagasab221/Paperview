<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Compose owns the real theming; this only styles the launch window so
         the cold-start flash matches the app instead of flashing white. -->
    <style name="Theme.PaperView" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/launch_background</item>
        <item name="android:statusBarColor">@color/launch_background</item>
        <item name="android:navigationBarColor">@color/launch_background</item>
    </style>
</resources>
